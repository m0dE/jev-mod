# --- Discord (required) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one server instantly instead of globally
DISCORD_GUILD_ID=
# Optional: default log channel. Each server can pick its own with /modlog.
MOD_LOG_CHANNEL_ID=

# --- AI moderation (recommended) ---
# Without a key the bot still runs, using keyword rules only.
# TypeSafe Jev (used if set): key from https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# How sure Jev must be (0-1) before acting on a message
# JEV_THRESHOLD=0.9
# How sure Jev must be that a message breaks a server's own /rule rules
# JEV_CUSTOM_THRESHOLD=0.7
# Messages at least this likely to be scams are removed with a 10 min mute (0.9+ gets 24 h)
# JEV_SCAM_THRESHOLD=0.6
# How sure Jev must be that someone's recent messages are a griefing/bullying pattern
# JEV_PATTERN_THRESHOLD=0.8
# How far back (minutes) griefing/bullying patterns are looked for
# PATTERN_WINDOW_MINUTES=30

# --- Keeping Jev usage down ---
# Messages are bundled for this long (ms) into one quick "could this break a rule?" check
# JEV_BATCH_MS=2000
# Only messages the quick check rates at least this get the full check (lower = safer, more tokens)
# JEV_GATE_THRESHOLD=0.3
# Most Jev input tokens per day (UTC); after that keyword rules only until midnight. 0 = no cap
JEV_DAILY_TOKEN_BUDGET=5000000
# Or Claude:
ANTHROPIC_API_KEY=
# MOD_MODEL=claude-opus-5-5
# MOD_EFFORT=low
# AI_MODERATION=off

# --- Punishments ---
# Mutes escalate 2 min → 10 min → 1 h → 6 h → 24 h (final warning) → ban.
# Subtle rudeness starts at 2 min, clear insults/griefing/bullying at 10 min, threats/slurs at 24 h.
# Each offense counts for 24 hours (severe ones for 30 days). Tune in src/config.js.

# Comma-separated IDs the bot ignores
IGNORED_CHANNEL_IDS=
EXEMPT_ROLE_IDS=

# Optional: replace the built-in rules the AI judges against
# SERVER_RULES="1. Be kind. 2. No griefing. 3. ..."
