# --- Discord (required) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to one server instantly instead of globally
DISCORD_GUILD_ID=
# Optional: channel where every moderation action is logged for staff
MOD_LOG_CHANNEL_ID=

# --- AI moderation (recommended) ---
# Without a key the bot still runs, using keyword rules only.
ANTHROPIC_API_KEY=
# MOD_MODEL=claude-opus-5-5
# MOD_EFFORT=low
# AI_MODERATION=off

# --- Strike ladder ---
# 1 = warning, 2 = 10 min timeout, 3 = final warning + 24 h timeout, 4 = ban
# Strikes older than this many days stop counting (0 = never expire)
STRIKE_EXPIRY_DAYS=30
# Threats, slurs, "kys" etc. add this many strikes at once
SEVERE_STRIKES=2

# Comma-separated IDs the bot ignores
IGNORED_CHANNEL_IDS=
EXEMPT_ROLE_IDS=

# Optional: replace the built-in rules the AI judges against
# SERVER_RULES="1. Be kind. 2. No griefing. 3. ..."
