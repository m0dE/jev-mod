# Jef Bot configuration. Copy to .env and fill in. Only PUBLIC_URL and one way to sign in
# are needed to start; everything else is optional and switches a feature on.

# --- Web server ---
# Where the site is reached from outside (no trailing slash). Used for OAuth redirects,
# Stripe return URLs, Discord links and cookies (https → Secure cookies + HSTS).
PUBLIC_URL=http://localhost:3000
# Port and interface. JEF_PORT / JEF_HOST win over PORT / HOST, for hosts where those are taken.
# JEF_PORT=3000
# JEF_HOST=0.0.0.0
# PORT=3000
# HOST=0.0.0.0
# Express "trust proxy": which proxies may set X-Forwarded-For (used for client IPs and rate
# limits). Default: loopback, linklocal, uniquelocal. Behind a remote proxy or load balancer,
# set it, e.g. 1 for one hop.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# Set to production on public servers (also disables DEV_LOGIN).
# NODE_ENV=production

# --- Storage ---
# SQLite database (created on first start). Keep it, and the data/ folder, between restarts.
# DB_FILE=data/jef-bot.db

# --- Accounts ---
# Comma-separated emails that can see every account. The first one owns the Discord servers
# migrated from the old single-server bot (on the unlimited internal plan).
ADMIN_EMAILS=
# Google sign-in: https://console.cloud.google.com/apis/credentials → OAuth client ID (Web application)
# Authorized redirect URI: ${PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local testing only: /auth/dev?email=… signs in as anyone. Ignored when NODE_ENV=production
# or when PUBLIC_URL is https; cross-site requests to /auth/dev are refused.
# NEVER set this on a public server.
# DEV_LOGIN=1

# --- Billing (Stripe) ---
# Without these the service runs, but only the Free plan is available.
# Secret key: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint ${PUBLIC_URL}/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
# Monthly recurring prices: "Jef Bot Starter" $5/month and "Jef Bot Pro" $20/month (price_…)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=

# --- Discord ---
# Without DISCORD_TOKEN the bot doesn't start; the API and dashboard still work.
# https://discord.com/developers/applications → your application
# Bot → Reset Token. Turn on the Message Content and Server Members intents.
DISCORD_TOKEN=
# General Information → Application ID
DISCORD_CLIENT_ID=
# OAuth2 → Client Secret. Lets "Add to server" link the server to the app automatically
# (the person must be signed in to the dashboard as the app's owner when Discord redirects back).
# Also add the redirect ${PUBLIC_URL}/discord/callback under OAuth2 → Redirects.
# Without it, server managers link with /jef link code:<code>.
DISCORD_CLIENT_SECRET=
# Optional: `npm run register` publishes slash commands to this one server instantly
# instead of globally (global can take up to an hour).
# DISCORD_GUILD_ID=
# Optional fallbacks for Discord apps that haven't set their own in the dashboard:
# a mod log channel, and comma-separated channel / role IDs that are never moderated.
# MOD_LOG_CHANNEL_ID=
# IGNORED_CHANNEL_IDS=
# EXEMPT_ROLE_IDS=

# --- AI moderation ---
# Without a key Jef Bot runs on the spam, scam and keyword checks only (no custom rules).
# TypeSafe Jev (used if set): key from https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=
# JEV_MODEL=jev-latest
# How sure Jev must be (0-1) before acting on a message
# JEV_THRESHOLD=0.9
# How sure Jev must be that a message breaks one of an app's custom rules
# JEV_CUSTOM_THRESHOLD=0.7
# Messages at least this likely to be scams are removed as "Possible scam" (medium); JEV_THRESHOLD+ is a full scam (high)
# JEV_SCAM_THRESHOLD=0.6
# How sure Jev must be that someone's recent messages are a griefing/bullying pattern
# JEV_PATTERN_THRESHOLD=0.8
# How far back (minutes) griefing/bullying patterns are looked for
# PATTERN_WINDOW_MINUTES=30

# --- Keeping Jev usage down ---
# Messages are bundled for this long (ms) into one quick "could this break a rule?" check
# JEV_BATCH_MS=2000
# Only messages the quick check rates at least this get the full check (lower = safer, more tokens)
# JEV_GATE_THRESHOLD=0.3
# Most Jev input tokens per day (UTC), across all accounts; after that keyword rules only until
# midnight. 0 = no cap. (Each account's plan also caps its own AI checks per month, and per
# UTC day at a tenth of that.)
JEV_DAILY_TOKEN_BUDGET=5000000
# Where today's token count is kept
# JEV_USAGE_FILE=data/jev-usage.json

# Or Claude, if TYPESAFE_API_KEY is not set (ANTHROPIC_AUTH_TOKEN also works):
ANTHROPIC_API_KEY=
# MOD_MODEL=claude-opus-5-5
# MOD_EFFORT=low
# Turn the AI off entirely (keyword rules only):
# AI_MODERATION=off

# Optional: replace the built-in rules the AI judges against, for every app
# SERVER_RULES="1. Be kind. 2. No griefing. 3. ..."

# --- Punishments ---
# Mutes escalate 2 min → 10 min → 1 h → 6 h → 24 h (final warning) → ban.
# Low severity starts at 2 min, medium at 10 min, high at the 24 h final warning.
# Each offense counts for 24 hours (high ones for 30 days). Tune LADDER / SEVERITY in src/config.js.

# --- Migrating from the single-server bot ---
# Read once on first start, imported into the database, then renamed to *.migrated.
# STRIKES_FILE=data/strikes.json
# SETTINGS_FILE=data/guild-settings.json
